# AI·Thoughts — MongoDB + auth config
# Copy to .env.local and fill in. Never commit real credentials.
#
# MONGODB_URL is a SERVER-side secret (no NEXT_PUBLIC_ prefix).
# Atlas+Vercel integration auto-creates MONGODB_URL.
# Example:
#   mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=
MONGODB_DB=aithoughts

# Secret used to sign session cookies and OTP hashes (src/lib/auth.ts, src/lib/otp.ts).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public site URL (metadata, sitemap, emails). Production example:
#   https://ai-thoughts-mu.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact address shown on Privacy / Contact pages.
NEXT_PUBLIC_CONTACT_EMAIL=keepers@ai-thoughts.app

# Resend (https://resend.com) — required in production to email OTP codes.
# Without RESEND_API_KEY, local/dev logs the code to the server console and
# returns it in the sign-in response for testing.
RESEND_API_KEY=
# Verified sender, e.g. AI·Thoughts <signin@yourdomain.com>
# Free Resend testing sender: AI·Thoughts <onboarding@resend.dev>
EMAIL_FROM=AI·Thoughts <onboarding@resend.dev>

# Vercel Blob store for audio/video takes (src/app/api/upload/route.ts).
# Create a store in the Vercel dashboard → Storage → Blob, then:
#   vercel env pull
BLOB_READ_WRITE_TOKEN=
