# AI·Thoughts — MongoDB config
# Copy to .env.local and fill in to connect the app to your MongoDB database.
# Heads-up: .env* is gitignored — never commit real credentials.
#
# MONGODB_URL is a SERVER-side secret (no NEXT_PUBLIC_ prefix). Used only by
# API routes in Node. The Atlas+Vercel integration auto-creates MONGODB_URL.
# Example:
#   mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=
MONGODB_DB=aithoughts

# Secret used to sign session cookies (src/lib/auth.ts, src/middleware.ts).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Vercel Blob store for audio/video takes (src/app/api/upload/route.ts).
# Recordings upload directly from the browser to Blob storage, so there's no
# server request-body size limit on how long a take can be.
# Create a store: Vercel dashboard → Project → Storage → Create Database → Blob
# (or `vercel blob create-store <name> --access public`), then:
#   vercel env pull
# to populate this locally.
BLOB_READ_WRITE_TOKEN=
