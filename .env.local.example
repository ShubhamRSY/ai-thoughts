# AI·Thoughts — MongoDB + auth config
# Copy to .env.local and fill in. Never commit real credentials.
#
# MONGODB_URL is a SERVER-side secret (no NEXT_PUBLIC_ prefix).
# Atlas+Vercel integration auto-creates MONGODB_URL.
# Example:
#   mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=
MONGODB_DB=aithoughts

# Secret used to sign session cookies and OTP hashes (src/lib/auth.ts, src/lib/otp.ts).
# Also used to derive email encryption keys unless EMAIL_ENCRYPTION_KEY is set.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Optional dedicated key for emailHash / emailEnc. Keep stable if you rotate AUTH_SECRET.
# EMAIL_ENCRYPTION_KEY=

# Optional override for POST /api/admin/seed (falls back to CRON_SECRET).
# ADMIN_SEED_SECRET=

# Comma-separated USER IDS that are always global admins (no DB row needed).
# Ids, not handles: a handle can be renamed away and registered by someone else.
# Find yours: sign in, open https://YOUR_APP/admin — the "No admin access" page shows it.
# (ADMIN_HANDLES is no longer honored.)
ADMIN_USER_IDS=

# Product-owner engagement dashboard (/owner + GET /api/owner/metrics).
# Generate a strong secret; do not share. Falls back to CRON_SECRET if unset.
# OWNER_DASHBOARD_SECRET=

# Public site URL (metadata, sitemap, emails). Production:
#   https://aito.social
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact address shown on Privacy / Contact pages.
NEXT_PUBLIC_CONTACT_EMAIL=keepers@aito.social

# Microsoft Store listing for Windows. Defaults to the live listing
# (https://apps.microsoft.com/detail/9MZ2LT2MJLX1); set only to override.
# NEXT_PUBLIC_MS_STORE_URL=
# Payment link for supporters (Stripe Payment Link, Ko-fi…). Unset = no Support page.
# NEXT_PUBLIC_SUPPORT_URL=
# Resend (https://resend.com) — required in production for OTP to ANY email.
# Permanent setup (required for friends/public signup):
#   1. Domain: aito.social (Namecheap)
#   2. Add + verify it at https://resend.com/domains (DNS records)
#   3. Set EMAIL_FROM, e.g.:
#        EMAIL_FROM=AiTo <signin@aito.social>
#   4. Redeploy
# onboarding@resend.dev only emails YOUR Resend account — not friends.
RESEND_API_KEY=
EMAIL_FROM=AiTo <signin@aito.social>

# Web Push (VAPID) — replies/reactions when the app is closed.
# Generate keys:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:keepers@aito.social
# Optional mirror for clients (same as VAPID_PUBLIC_KEY):
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional Cloudflare Turnstile CAPTCHA on "Send sign-in code" (free:
# dash.cloudflare.com → Turnstile). Set both to turn it on; unset = off.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional automated screening of take text + photos and avatars with
# OpenAI's free moderation model (platform.openai.com). Unset = off.
# OPENAI_API_KEY=

# Site-wide cap on sign-in emails per hour (default 40). Size it to your
# Resend plan; when it's hit, nobody new can sign in until the hour resets.
# OTP_EMAILS_PER_HOUR=40

# Protects /api/cron/* (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# Local-only escape hatch: with no secret set, bearer-guarded routes (cron,
# admin bootstrap) stay closed unless this is "1". Ignored in production and
# on every Vercel deploy. Never set it on a machine others can reach.
# ALLOW_INSECURE_DEV_AUTH=1

# Self-hosted only (ignored on Vercel): how many proxies you run that append
# to X-Forwarded-For (e.g. 1 for a single nginx with proxy_add_x_forwarded_for).
# Unset = the header is untrusted and all callers share one rate-limit bucket.
# TRUSTED_PROXY_HOPS=1

# Vercel Blob store for audio/video takes (src/app/api/upload/route.ts).
# Create a store in the Vercel dashboard → Storage → Blob, then:
#   vercel env pull
BLOB_READ_WRITE_TOKEN=

# Private Blob store for takes' audio/video/photos and the daily backups
# (src/lib/media-access.ts). Create a SECOND store with access "Private"
# (Storage → Blob → Create → Private) and paste its read-write token here.
# Files there open only through short-lived signed links the app hands to
# people allowed to see the take. Unset = takes upload to the public store.
# BLOB_PRIVATE_READ_WRITE_TOKEN=

# How many daily database archives to keep in Blob (src/lib/backup-retention.ts).
# Only matters because production is on Atlas Free (M0), which has no managed
# snapshots, so /api/cron/backup is the only recovery path. Unset = 14.
# BACKUP_KEEP=14

# Optional: makes rate limiting (src/lib/rate-limit.ts) shared across all
# serverless instances instead of per-instance in-memory. Free tier is
# plenty for this app. Create a free Redis database at https://upstash.com,
# then copy its REST URL + token (both, or leave both unset to skip this).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# (On Vercel, the Upstash integration's KV_REST_API_URL / KV_REST_API_TOKEN work too.)
