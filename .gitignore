# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# native / desktop builds
/desktop/node_modules
/desktop/dist
/android/.gradle
/android/app/build
/android/build
/ios/App/Pods
/ios/DerivedData

