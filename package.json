{
  "name": "ai-thoughts",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-turnstile-bundle.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/run-unit-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "seed": "node scripts/seed-mongo.mjs",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap sync ios && npx cap open ios",
    "desktop:install": "npm install --prefix desktop",
    "desktop:start": "npm start --prefix desktop",
    "desktop:win": "npm run pack:win --prefix desktop",
    "desktop:publish": "npm run publish:win --prefix desktop",
    "prelaunch": "node scripts/prelaunch-check.mjs",
    "drill:check": "node scripts/restore-drill-check.mjs",
    "db:dump": "node --experimental-strip-types scripts/mongo-dump.mjs",
    "db:restore": "node --experimental-strip-types scripts/mongo-restore.mjs",
    "backfill:uploads": "node --experimental-strip-types scripts/backfill-upload-owners.mjs",
    "rebuild:messages-index": "node scripts/rebuild-messages-index.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@gsap/react": "^2.1.2",
    "@sentry/nextjs": "^11.1.0",
    "@upstash/redis": "^1.38.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.5",
    "gsap": "^3.15.0",
    "lucide-react": "^1.39.0",
    "mongodb": "^7.6.0",
    "next": "^16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "^16.3.7",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
